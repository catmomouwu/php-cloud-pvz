# 复制为 .env 供本地开发使用（nitro dev 自动读取）

# better-auth 密钥：openssl rand -base64 32
NITRO_AUTH_SECRET=
# 浏览器访问的地址（开发时是 Vite 的地址）
NITRO_AUTH_BASE_URL=http://localhost:5173
NITRO_AUTH_TRUSTED_ORIGINS=http://localhost:5173
# 限流识别客户端 IP 的可信请求头；部署在反向代理后面时填 x-forwarded-for，直接暴露时留空
NITRO_AUTH_IP_ADDRESS_HEADERS=

# S3 兼容存储；本地用 compose.dev.yaml 启动的 MinIO
NITRO_S3_ENDPOINT=http://localhost:9100
NITRO_S3_REGION=us-east-1
NITRO_S3_BUCKET=cloud-pvz-saves
NITRO_S3_ACCESS_KEY_ID=cloudpvz
NITRO_S3_SECRET_ACCESS_KEY=cloudpvz-dev-secret
