{
  "name": "cloud-pvz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "run-p dev:web dev:server",
    "dev:web": "vite",
    "dev:server": "nitro dev --port 3000",
    "build": "vite build && node scripts/postbuild-web.mjs && nitro build",
    "build:cf": "vite build && node scripts/postbuild-web.mjs && NITRO_PRESET=cloudflare_module nitro build",
    "preview": "node .output/server/index.mjs",
    "type-check": "vue-tsc --build && nitro prepare && tsc --noEmit -p server",
    "db:generate": "drizzle-kit generate",
    "dev:s3": "docker compose -f compose.dev.yaml up -d"
  },
  "dependencies": {
    "@felinic/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@vueuse/core": "^14.4.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-vue-next": "0.562.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "drizzle-kit": "^0.31.11",
    "h3": "1.15.11",
    "nitropack": "^2.13.4",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
